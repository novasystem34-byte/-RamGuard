<Window x:Class="RamGuard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="RAM Guard" Height="740" Width="1120"
        Background="{StaticResource BgDark}"
        FontFamily="Segoe UI" FontSize="13"
        WindowStartupLocation="CenterScreen">

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Grid Grid.Row="0" Margin="0,0,0,10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse Width="10" Height="10" Fill="{StaticResource Accent}" Margin="0,0,8,0"/>
                <TextBlock Text="RAM Guard" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextPrimary}"/>
                <TextBlock Text="مراقبة وتحديد استهلاك الذاكرة" FontSize="12"
                           Foreground="{StaticResource TextSecondary}" Margin="12,4,0,0"/>
            </StackPanel>

            <TextBox Grid.Column="1" Width="220" Style="{StaticResource FlatTextBox}"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     Tag="بحث بالاسم أو PID..." VerticalAlignment="Center"/>
        </Grid>

        <!-- Alerts settings row -->
        <Border Grid.Row="1" Background="{StaticResource BgPanel}" CornerRadius="8"
                Padding="14,8" Margin="0,0,0,10" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <CheckBox Content="تنبيه صوتي عند تجاوز عملية للحد" Foreground="{StaticResource TextPrimary}"
                          IsChecked="{Binding SoundAlertsEnabled}" VerticalAlignment="Center"/>
                <TextBlock Text="الحد (MB):" Foreground="{StaticResource TextSecondary}"
                           Margin="18,0,6,0" VerticalAlignment="Center"/>
                <TextBox Width="80" Style="{StaticResource FlatTextBox}" VerticalAlignment="Center"
                         Text="{Binding AlertThresholdMb, UpdateSourceTrigger=PropertyChanged}"/>
                <TextBlock Text="(ينبّهك بصوت + بالون من صينية النظام لما أي عملية مفردة تتجاوز هالرقم)"
                           Foreground="{StaticResource TextSecondary}" FontSize="11"
                           Margin="14,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </Border>

        <!-- Total memory bar -->
        <Border Grid.Row="2" Background="{StaticResource BgPanel}" CornerRadius="8"
                Padding="14,10" Margin="0,0,0,14" BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="الذاكرة الكلية:" Foreground="{StaticResource TextSecondary}"
                           VerticalAlignment="Center" Margin="0,0,10,0"/>

                <Border Grid.Column="1" Height="10" Background="{StaticResource BgRow}" CornerRadius="5" VerticalAlignment="Center">
                    <Border HorizontalAlignment="Left" Height="10" CornerRadius="5" Background="{StaticResource Accent}"
                            Width="{Binding TotalMemoryPercent, Converter={StaticResource PercentToWidth}, FallbackValue=0}"/>
                </Border>

                <TextBlock Grid.Column="2" Text="{Binding TotalMemoryText}" Foreground="{StaticResource TextPrimary}"
                           Margin="14,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold"/>
            </Grid>
        </Border>

        <!-- Grouped process list -->
        <Border Grid.Row="3" Background="{StaticResource BgPanel}" CornerRadius="8"
                BorderBrush="{StaticResource BorderColor}" BorderThickness="1">
            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="4">
                <StackPanel>

                    <!-- Column headers -->
                    <Grid Margin="6,4,6,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="34"/>
                            <ColumnDefinition Width="220"/>
                            <ColumnDefinition Width="70"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="90"/>
                            <ColumnDefinition Width="130"/>
                            <ColumnDefinition Width="80"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="الاسم" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="2" Text="PID" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="3" Text="الرام (MB)" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="4" Text="المعالج %" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="5" Text="سقف الذاكرة (MB)" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="6" Text="الحالة" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                        <TextBlock Grid.Column="7" Text="إجراءات" Foreground="{StaticResource TextSecondary}" FontWeight="SemiBold"/>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding Groups}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border BorderBrush="{StaticResource BorderColor}" BorderThickness="0,0,0,1" Margin="0,0,0,2">
                                    <StackPanel>

                                        <!-- Group header row -->
                                        <Grid Background="{StaticResource BgRow}" Height="38">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="34"/>
                                                <ColumnDefinition Width="220"/>
                                                <ColumnDefinition Width="70"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="90"/>
                                                <ColumnDefinition Width="130"/>
                                                <ColumnDefinition Width="80"/>
                                                <ColumnDefinition Width="*"/>
                                            </Grid.ColumnDefinitions>

                                            <Button Grid.Column="0" Background="Transparent" BorderThickness="0"
                                                    Foreground="{StaticResource TextPrimary}" Cursor="Hand"
                                                    Command="{Binding DataContext.ToggleGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}">
                                                <TextBlock Text="{Binding IsExpanded, Converter={StaticResource ExpandArrow}}" FontSize="12"/>
                                            </Button>

                                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                                <TextBlock Text="⚠" Foreground="{StaticResource Warning}" Margin="0,0,4,0"
                                                           Visibility="{Binding HasSuspicious, Converter={StaticResource BoolToVis}}"/>
                                                <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                                                <TextBlock Text="{Binding Count, StringFormat=({0})}" Foreground="{StaticResource TextSecondary}" Margin="6,0,0,0"/>
                                            </StackPanel>

                                            <TextBlock Grid.Column="3" Text="{Binding TotalMemoryMb, StringFormat={}{0:N1}}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="4" Text="{Binding TotalCpuPercent, StringFormat={}{0:N1}}"
                                                       FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

                                            <Button Grid.Column="7" Content="تفريغ الكل (آمن)" Style="{StaticResource FlatButton}"
                                                    HorizontalAlignment="Left" Margin="4,0"
                                                    Command="{Binding DataContext.TrimGroupCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    ToolTip="يفرّغ ذاكرة كل العمليات الفرعية ضمن هالمجموعة"/>
                                        </Grid>

                                        <!-- Children rows (لما توسّع المجموعة) -->
                                        <ItemsControl ItemsSource="{Binding Children}"
                                                      Visibility="{Binding IsExpanded, Converter={StaticResource BoolToVis}}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Grid Height="36" Background="{StaticResource BgPanel}">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="34"/>
                                                            <ColumnDefinition Width="220"/>
                                                            <ColumnDefinition Width="70"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="90"/>
                                                            <ColumnDefinition Width="130"/>
                                                            <ColumnDefinition Width="80"/>
                                                            <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock Grid.Column="0" Text="↳" Foreground="{StaticResource TextSecondary}"
                                                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="1" Text="{Binding FullPath}" FontSize="10" TextTrimming="CharacterEllipsis"
                                                                   Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" Margin="4,0"/>
                                                        <TextBlock Grid.Column="2" Text="{Binding Id}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="3" Text="{Binding MemoryMb, StringFormat={}{0:N1}}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                                                        <TextBlock Grid.Column="4" Text="{Binding CpuPercent, StringFormat={}{0:N1}}" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>

                                                        <TextBox Grid.Column="5" Style="{StaticResource FlatTextBox}" Margin="4,3"
                                                                 Text="{Binding LimitMb, UpdateSourceTrigger=PropertyChanged}"/>

                                                        <TextBlock Grid.Column="6" Text="محدّد" Foreground="{StaticResource Danger}" FontWeight="SemiBold"
                                                                   VerticalAlignment="Center"
                                                                   Visibility="{Binding IsHardLimited, Converter={StaticResource BoolToVis}}"/>

                                                        <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="تفريغ" Style="{StaticResource FlatButton}" Margin="2,0"
                                                                    Command="{Binding DataContext.TrimCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="يفرّغ الذاكرة الفيزيائية غير المستخدمة - آمن 100%"/>
                                                            <Button Content="طبّق حد صارم" Style="{StaticResource FlatButton}" Margin="2,0"
                                                                    Command="{Binding DataContext.ApplyLimitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"
                                                                    ToolTip="تحذير: تجاوز الحد قد يعلّق أو يكرش البرنامج"/>
                                                            <Button Content="رفع الحد" Style="{StaticResource FlatButton}" Margin="2,0"
                                                                    Command="{Binding DataContext.RemoveLimitCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}"/>
                                                        </StackPanel>
                                                    </Grid>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>

                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Status bar -->
        <Grid Grid.Row="4" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="{Binding StatusText}" Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center"/>
            <Button Grid.Column="1" Content="تحديث الآن" Style="{StaticResource FlatButton}"
                    Command="{Binding RefreshNowCommand}"/>
        </Grid>
    </Grid>
</Window>
